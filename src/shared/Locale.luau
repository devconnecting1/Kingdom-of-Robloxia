Locale.tables = { en = en, pt = pt }
Locale.current = "en"

-- Roblox locale ids look like "pt-br" or "en-us"; anything Portuguese gets Portuguese.
function Locale.fromRobloxId(id: string): string
	if string.sub(string.lower(id), 1, 2) == "pt" then
		return "pt"
	end
	return "en"
end

function Locale.set(lang: string)
	Locale.current = if Locale.tables[lang] then lang else "en"
end

function Locale.t(key: string, params: { [string]: any }?): string
	local text = Locale.tables[Locale.current][key] or en[key] or key
	if params then
		text = string.gsub(text, "{(%w+)}", function(name)
			local v = params[name]
			return if v ~= nil then tostring(v) else "{" .. name .. "}"
		end)
	end
	return text
end

return Locale
