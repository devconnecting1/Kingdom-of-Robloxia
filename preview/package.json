{
  "name": "kingdom-of-robloxia-preview",
  "private": true,
  "version": "0.1.0",
  "description": "Renders the game's real Luau interface (exported by tools/render.luau) in a browser for screenshots.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "eslint": "9.15.0",
    "globals": "15.12.0",
    "playwright": "1.49.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11"
  }
}
