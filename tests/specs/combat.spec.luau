return function(test, expect, load)
	local Army = load("shared/Rules/Army")
	local Combat = load("shared/Rules/Combat")
	local Schema = load("shared/Rules/Schema")

	local function side(troops, wall)
		return { data = Schema.new("X", 0), troops = troops, wallBonus = wall }
	end

	test("the bigger army wins", function()
		local r = Combat.battle(side({ inf1 = 1000 }), side({ inf1 = 200 }))
		expect.truthy(r.attackerWon)
		expect.truthy(Army.total(r.attacker.survivors) > 0)
		local r2 = Combat.battle(side({ inf1 = 200 }), side({ inf1 = 1000 }))
		expect.falsy(r2.attackerWon)
	end)

	test("counters matter: cavalry beats the same number of archers", function()
		local r = Combat.battle(side({ cav1 = 500 }), side({ rng1 = 500 }))
		local reverse = Combat.battle(side({ rng1 = 500 }), side({ cav1 = 500 }))
		expect.truthy(r.defender.powerLost > r.attacker.powerLost)
		expect.truthy(reverse.attacker.powerLost > reverse.defender.powerLost)
		expect.eq(Combat.counter("infantry", "cavalry"), 1.3)
		expect.eq(Combat.counter("infantry", "ranged"), 0.8)
		expect.eq(Combat.counter("siege", "infantry"), 1)
	end)

	test("battles are deterministic", function()
		local a = Combat.battle(side({ inf1 = 321, cav1 = 77 }), side({ rng1 = 280, inf1 = 40 }, 0.2))
		local b = Combat.battle(side({ inf1 = 321, cav1 = 77 }), side({ rng1 = 280, inf1 = 40 }, 0.2))
		expect.same(a, b)
	end)

	test("losses never exceed the troops that fought", function()
		local r = Combat.battle(side({ inf3 = 5000 }), side({ inf1 = 3 }))
		expect.truthy((r.defender.lost.inf1 or 0) <= 3)
		expect.eq(Army.total(r.defender.survivors) + Army.total(r.defender.lost), 3)
	end)

	test("an empty castle falls at once", function()
		local r = Combat.battle(side({ inf1 = 10 }), side({}, 0.5))
		expect.truthy(r.attackerWon)
		expect.eq(r.rounds, 0)
	end)

	test("siege engines cancel the wall bonus", function()
		local plain = Combat.battle(side({ inf1 = 500 }), side({ inf1 = 500 }, 0.5))
		local siege = Combat.battle(side({ inf1 = 250, sie1 = 250 }), side({ inf1 = 500 }, 0.5))
		expect.eq(plain.wallBonus, 0.5)
		expect.eq(siege.wallBonus, 0)
	end)

	test("wounded only fit while the infirmary has room", function()
		local dead, wounded = Combat.splitLosses({ inf1 = 100, rng1 = 50 }, 1, 120)
		expect.eq(Army.total(wounded), 120)
		expect.eq(Army.total(dead), 30)
		local dead2, wounded2 = Combat.splitLosses({ inf1 = 100 }, 0.6, 0)
		expect.eq(Army.total(wounded2), 0)
		expect.eq(dead2.inf1, 100)
	end)

	test("hunt damage and rewards scale with the army", function()
		local data = Schema.new("X", 0)
		local small = Combat.huntDamage(data, { inf1 = 10 })
		local big = Combat.huntDamage(data, { inf1 = 100 })
		expect.eq(big, small * 10)
		local half = Combat.huntRewards("golem", 1, 3000, 6000, false)
		local kill = Combat.huntRewards("golem", 1, 3000, 6000, true)
		expect.truthy(kill.stone > half.stone)
		expect.truthy(Combat.huntDamage(data, { inf1 = 10 }, "thorne", 1) > small)
	end)
end
